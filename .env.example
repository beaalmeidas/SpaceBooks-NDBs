# Run: py -3 -m src.configure_env (generates local random passwords).
# Never commit .env; keep CHANGE_ME_* placeholders only in this example.
MONGO_USERNAME=spacebooks
MONGO_PASSWORD=CHANGE_ME_MONGO
MONGO_DATABASE=spacebooks
MONGO_PORT=27017
REDIS_PASSWORD=CHANGE_ME_REDIS
REDIS_PORT=6379
CATALOG_CACHE_TTL_SECONDS=60
REDIS_CACHE_TIMEOUT_SECONDS=0.25
REDIS_SESSION_TIMEOUT_SECONDS=1
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
DB_TIMEOUT_SECONDS=10
DB_QUERY_TIMEOUT_SECONDS=60
STREAMLIT_PORT=8501
# Optional for Python running outside Compose:
# MONGO_URI=mongodb://user:password@localhost:27017/?authSource=admin&directConnection=true
# REDIS_URL=redis://:password@localhost:6379/0
# NEO4J_URI=bolt://127.0.0.1:7687
